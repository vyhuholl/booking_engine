{
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://booking:booking@localhost:5432/booking?sslmode=disable"
      ],
      "env": {}
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./api"
      ],
      "env": {}
    },
    "openapi": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "-C",
        "tools/mcp-openapi",
        ".",
        "../../api/openapi.yaml"
      ],
      "env": {}
    }
  }
}