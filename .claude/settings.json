{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=$(jq -r \".tool_input.file_path\" < /dev/stdin); if [[ \"$FILE\" == *.go ]]; then gofmt -w \"$FILE\" 2>/dev/null; fi'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'MSG=$(jq -r \".message\" < /dev/stdin); echo \"Claude Code: $MSG\" >> /tmp/claude-notifications.log'"
          }
        ]
      }
    ]
  }
}